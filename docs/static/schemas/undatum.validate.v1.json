{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datenoio.github.io/undatum/schemas/undatum.validate.v1.json",
  "title": "Rule-file validation report",
  "description": "Printed by `undatum validate --rules --json`.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "undatum.validate/1",
      "description": "Result layout"
    },
    "statistics": {
      "type": "object",
      "description": "total_records, total_violations, errors, warnings, info, passed; with a data contract also failed_checks (error, warning, info)"
    },
    "violations_by_field": {
      "type": "object",
      "description": "Field -> number of violations"
    },
    "violations_by_rule": {
      "type": "object",
      "description": "Rule -> number of violations"
    },
    "violations": {
      "type": "array",
      "description": "Violations (at most --max-violations)"
    },
    "contract": {
      "type": "object",
      "description": "With an ODCS data contract: object, checks (name, fields, metric, value, unit, operator, limit, expected, passed, severity, description), not_checked (name, reason)"
    }
  },
  "required": [
    "schema",
    "statistics",
    "violations"
  ]
}
