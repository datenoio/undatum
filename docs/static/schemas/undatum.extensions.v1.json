{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datenoio.github.io/undatum/schemas/undatum.extensions.v1.json",
  "title": "DuckDB extensions undatum uses and whether they are installed",
  "description": "Printed by `undatum extensions list --json`.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "undatum.extensions/1",
      "description": "Result layout"
    },
    "directory": {
      "type": "string",
      "description": "Extension directory"
    },
    "extensions": {
      "type": "array",
      "description": "Extensions: name, purpose, installed, path, size (bytes); install adds downloaded"
    }
  },
  "required": [
    "schema",
    "directory",
    "extensions"
  ]
}
