{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datenoio.github.io/undatum/schemas/undatum.cache.v1.json",
  "title": "Cached command results",
  "description": "Printed by `undatum cache list --json`.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "undatum.cache/1",
      "description": "Result layout"
    },
    "directory": {
      "type": "string",
      "description": "Cache directory"
    },
    "entries": {
      "type": "array",
      "description": "Cached files: path, size, mtime, stale, bytes, results (command, created, bytes)"
    }
  },
  "required": [
    "schema",
    "directory",
    "entries"
  ]
}
